      "id": "f3dfa76d-ec5f-4b15-9d59-ef1006a91d63",
      "name": "Pip the Barista",
      "order": 0,
      "technicalName": "Pip",
      "templateId": "26ef41ca-b9e2-4938-b43c-0c7924179f49",
      "values": {
        "dda33cf5-3d0d-4fd4-966f-4d684e99ad5d": "Runs the tiniest café in town. Takes foam art very seriously."
      }
    }
  },
  "flows": {
    "ced87b88-daaf-445d-b4da-e4db7d994a39": {
      "comments": {
        "95c68fc0-fab0-4604-a848-676b8cae6457": {
          "author": "Alex",
          "createdAt": "2026-01-01T00:00:00.000Z",
          "id": "95c68fc0-fab0-4604-a848-676b8cae6457",
          "nodeId": "9e67e600-8a8f-40ad-a9fb-3cbf250027cf",
          "parentId": "c811c3ba-8a09-4348-a013-254891dd5abf",
          "text": "Keep it at the end: it only shows up when you have a coin left."
        },
        "c811c3ba-8a09-4348-a013-254891dd5abf": {
          "author": "Sam",
          "createdAt": "2026-01-01T00:00:00.000Z",
          "id": "c811c3ba-8a09-4348-a013-254891dd5abf",
          "nodeId": "9e67e600-8a8f-40ad-a9fb-3cbf250027cf",
          "text": "Should Pip mention the jar before you order instead?"
        }
      },
