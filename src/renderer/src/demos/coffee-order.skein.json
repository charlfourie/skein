      "folderId": null,
      "id": "ced87b88-daaf-445d-b4da-e4db7d994a39",
      "name": "The Order",
      "nodes": {
        "01d9c28a-c954-4c7c-951a-bee15e2e08bc": {
          "data": {
            "lineId": "ORDER_01d9c2",
            "menuText": "Just water (free)",
            "note": "Free, so you are never stuck with nothing to pick. Only once: after a glass it leaves the menu, so every path ends (Explore checks this).",
            "once": true,
            "speakerId": "0a1943b8-de62-44b6-b829-ef96c400b453",
            "text": "Just water, thanks."
          },
          "id": "01d9c28a-c954-4c7c-951a-bee15e2e08bc",
          "position": {
            "x": 0,
            "y": 632
          },
          "type": "dialogue"
        },
        "0741fc17-fbf7-4546-9dd8-1806b89c4027": {
          "data": {
            "note": "A jump continues the flow somewhere else: here, back to the menu, so you can keep ordering until the coins run out.",
            "targetId": "4d02fe43-acf4-4a6c-9821-85f2d7c2363b"
          },
          "id": "0741fc17-fbf7-4546-9dd8-1806b89c4027",
          "position": {
            "x": 472,
            "y": 1264
          },
          "type": "jump"
        },
        "0998f58f-8eb4-4574-83a1-238d25a04648": {
          "data": {
            "lineId": "ORDER_0998f5",
            "menuText": "Drop in a handful (3 coins)",
            "requires": "not Seen.TipTooBig",
            "speakerId": "0a1943b8-de62-44b6-b829-ef96c400b453",
            "text": "Keep the change. All of it."
          },
          "id": "0998f58f-8eb4-4574-83a1-238d25a04648",
          "position": {
            "x": 2216,
            "y": 1264
          },
          "type": "dialogue"
        },
        "1169b66a-9af9-4a68-9084-50078bb7155b": {
          "data": {
            "note": "Back to the tip jar to choose again.",
            "targetId": "3e3ed6f2-037a-480e-8cbb-4ecca714cf14"
          },
          "id": "1169b66a-9af9-4a68-9084-50078bb7155b",
          "position": {
            "x": 2368,
            "y": 1888
          },
          "type": "jump"
        },
        "15635f8a-ff9c-4fa4-adc5-1cc0a51e6436": {
          "data": {
            "expression": "Player.Coins >= 3",
            "note": "Can you pay 3 coins? True serves it, false sends you back to the menu."
          },
          "id": "15635f8a-ff9c-4fa4-adc5-1cc0a51e6436",
          "position": {
            "x": 1104,
            "y": 632
          },
          "type": "condition"
        },
        "24cb6ec4-a792-48c8-81ec-242f19fc1142": {
          "data": {
            "isStart": true,
            "lineId": "ORDER_24cb6e",
            "note": "Start here. Open Play (the triangle in the toolbar) and watch Coins at the top of the panel.",
            "speakerId": "f3dfa76d-ec5f-4b15-9d59-ef1006a91d63",
            "text": "Morning! What can I get you?"
          },
          "id": "24cb6ec4-a792-48c8-81ec-242f19fc1142",
          "position": {
            "x": 1104,
            "y": 0
          },
          "type": "dialogue"
        },
        "24f4f7b2-a4e3-4cb6-8786-1a02a45e688d": {
          "data": {
            "lineId": "ORDER_24f4f7",
            "menuText": "That's everything",
            "speakerId": "0a1943b8-de62-44b6-b829-ef96c400b453",
            "text": "That's everything, thanks."
          },
          "id": "24f4f7b2-a4e3-4cb6-8786-1a02a45e688d",
          "position": {
            "x": 2368,
            "y": 424
          },
          "type": "dialogue"
        },
        "2c5fa18f-ae51-40ba-a613-c71cdd3e4354": {
          "data": {
            "lineId": "ORDER_2c5fa1",
            "menuText": "Hot chocolate (3 coins)",
            "note": "Offered until Pip has told you it's too dear: coins only go down, so asking again wouldn't change her answer (and Explore can see every path ends).",
