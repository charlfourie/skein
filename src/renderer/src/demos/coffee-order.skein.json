      "folderId": null,
      "id": "d9d2e655-47c2-4956-ad41-628ddbfea87f",
      "name": "The Order",
      "nodes": {
        "04d941b7-d481-4549-a8c2-f50530deec15": {
          "data": {
            "isEnd": true,
            "speakerId": "ea5b376a-6183-40a7-8881-86123be65240",
            "text": "You're a star. Next foam fern is extra leafy."
          },
          "id": "04d941b7-d481-4549-a8c2-f50530deec15",
          "position": {
            "x": 1104,
            "y": 1264
          },
          "type": "dialogue"
        },
        "080e0f12-978f-4fbf-b96a-98cf2174346b": {
          "data": {
            "speakerId": "ea5b376a-6183-40a7-8881-86123be65240",
            "text": "On the house!"
          },
          "id": "080e0f12-978f-4fbf-b96a-98cf2174346b",
          "position": {
            "x": 952,
            "y": 632
          },
          "type": "dialogue"
        },
        "12cc1c25-436e-41ed-a2f6-d25eda3eb8a1": {
          "data": {
            "speakerId": "ea5b376a-6183-40a7-8881-86123be65240",
            "text": "One flat white, with a fern on top."
          },
          "id": "12cc1c25-436e-41ed-a2f6-d25eda3eb8a1",
          "position": {
            "x": 0,
            "y": 632
          },
          "type": "dialogue"
        },
        "1d226b86-d5b7-49c1-b876-9fa7d5c9862b": {
          "data": {
            "isEnd": true,
            "speakerId": "ea5b376a-6183-40a7-8881-86123be65240",
            "text": "Pockets empty? Come back tomorrow, I'll save you a biscuit."
          },
          "id": "1d226b86-d5b7-49c1-b876-9fa7d5c9862b",
          "position": {
            "x": 1584,
            "y": 840
          },
          "type": "dialogue"
        },
        "284b0a6f-63cb-4bc2-9653-13c1c07b5296": {
          "data": {
            "speakerId": "ea5b376a-6183-40a7-8881-86123be65240",
            "text": "Marshmallow tower, coming right up."
          },
          "id": "284b0a6f-63cb-4bc2-9653-13c1c07b5296",
          "position": {
            "x": 320,
            "y": 632
          },
          "type": "dialogue"
        },
        "2ed654c4-864f-419d-a1c0-3e5be1934dc0": {
          "data": {
            "label": "The menu",
            "note": "A hub with several outputs offers a choice. Each priced option has a Requires: when you can't afford it, Play shows it locked with what it needs."
          },
          "id": "2ed654c4-864f-419d-a1c0-3e5be1934dc0",
          "position": {
            "x": 472,
            "y": 208
          },
          "type": "hub"
        },
        "30986c8d-66ae-4682-bcc8-c2ebb3475cde": {
          "data": {
            "effects": "Player.Coins -= 1",
            "menuText": "Drop a coin in the jar (1 coin)",
            "requires": "Player.Coins >= 1",
            "speakerId": "6254c6d9-119b-4d1f-8392-dff6cc609b7d",
            "text": "Here you go."
          },
          "id": "30986c8d-66ae-4682-bcc8-c2ebb3475cde",
          "position": {
            "x": 1104,
            "y": 1048
          },
          "type": "dialogue"
        },
        "4772f077-eebb-4d50-be98-4205b3c7517a": {
          "data": {
            "speakerId": "ea5b376a-6183-40a7-8881-86123be65240",
            "text": "Last one in the jar. Lucky you."
          },
          "id": "4772f077-eebb-4d50-be98-4205b3c7517a",
          "position": {
            "x": 632,
            "y": 632
          },
          "type": "dialogue"
        },
        "4ac636ae-ec69-4c8a-998e-d6da58894e82": {
          "data": {
            "speakerId": "ea5b376a-6183-40a7-8881-86123be65240",
            "text": "There's a tip jar by the till, if you like."
          },
          "id": "4ac636ae-ec69-4c8a-998e-d6da58894e82",
          "position": {
            "x": 1264,
            "y": 840
          },
          "type": "dialogue"
        },
        "586e3664-7b7d-463e-8776-babc20e4ba7e": {
          "data": {
            "effects": "Player.Coins -= 1\nPlayer.ItemsBought += 1",
            "menuText": "A ginger biscuit (1 coin)",
            "note": "Only offered with 1+ coins. Effects spend the coins as the story passes through.",
            "requires": "Player.Coins >= 1",
            "speakerId": "6254c6d9-119b-4d1f-8392-dff6cc609b7d",
            "text": "And one of those ginger biscuits."
          },
          "id": "586e3664-7b7d-463e-8776-babc20e4ba7e",
          "position": {
            "x": 632,
            "y": 424
          },
          "type": "dialogue"
        },
        "630709f4-091c-47f6-8916-ec1efc8d38d3": {
          "data": {
            "effects": "Player.Coins -= 3\nPlayer.ItemsBought += 1",
            "menuText": "Hot chocolate (3 coins)",
            "note": "Only offered with 3+ coins. Effects spend the coins as the story passes through.",
            "requires": "Player.Coins >= 3",
            "speakerId": "6254c6d9-119b-4d1f-8392-dff6cc609b7d",
            "text": "Hot chocolate. Extra marshmallows."
          },
          "id": "630709f4-091c-47f6-8916-ec1efc8d38d3",
          "position": {
            "x": 320,
            "y": 424
          },
          "type": "dialogue"
        },
        "769dd27f-b33d-4d1f-b562-c3a1f41c66b3": {
          "data": {
            "menuText": "Not today",
            "speakerId": "6254c6d9-119b-4d1f-8392-dff6cc609b7d",
            "text": "Not today, sorry."
          },
          "id": "769dd27f-b33d-4d1f-b562-c3a1f41c66b3",
          "position": {
            "x": 1424,
            "y": 1048
          },
          "type": "dialogue"
        },
        "7e248689-30f0-4e33-888e-861b1407b585": {
          "data": {
            "expression": "Player.Coins >= 1",
            "note": "Conditions branch automatically: green is true, red is false."
          },
          "id": "7e248689-30f0-4e33-888e-861b1407b585",
          "position": {
            "x": 1424,
            "y": 632
          },
          "type": "condition"
        },
        "81104934-9572-477f-a1d5-37976e9a647d": {
          "data": {
            "speakerId": "ea5b376a-6183-40a7-8881-86123be65240",
            "text": "Anything else?"
          },
          "id": "81104934-9572-477f-a1d5-37976e9a647d",
          "position": {
            "x": 472,
            "y": 840
          },
          "type": "dialogue"
        },
        "82c2730b-874a-4e13-ad8f-7c9dfac78786": {
          "data": {
            "menuText": "That's everything",
            "speakerId": "6254c6d9-119b-4d1f-8392-dff6cc609b7d",
            "text": "That's everything, thanks."
          },
          "id": "82c2730b-874a-4e13-ad8f-7c9dfac78786",
          "position": {
            "x": 1424,
            "y": 424
          },
          "type": "dialogue"
        },
        "94ebe060-1dbf-4871-a8ee-92a1ad33b306": {
          "data": {
            "isStart": true,
            "note": "Start here. Open Play (the triangle in the toolbar) and watch Coins at the top of the panel.",
            "speakerId": "ea5b376a-6183-40a7-8881-86123be65240",
            "text": "Morning! What can I get you?"
          },
          "id": "94ebe060-1dbf-4871-a8ee-92a1ad33b306",
          "position": {
            "x": 472,
            "y": 0
          },
          "type": "dialogue"
        },
        "96f33287-eb89-4b13-b626-b5062d8cfcbd": {
          "data": {
            "menuText": "Just water (free)",
            "note": "Free, so you are never stuck with nothing to pick. Only once: after a glass it leaves the menu, so every path ends (Explore checks this).",
            "once": true,
            "speakerId": "6254c6d9-119b-4d1f-8392-dff6cc609b7d",
            "text": "Just water, thanks."
          },
          "id": "96f33287-eb89-4b13-b626-b5062d8cfcbd",
          "position": {
            "x": 952,
            "y": 424
          },
          "type": "dialogue"
        },
        "b9a833ba-372d-41ef-b8a5-80b182c7cb7a": {
          "data": {
            "note": "A jump continues the flow somewhere else: here, back to the menu, so you can keep ordering until the coins run out.",
            "targetId": "2ed654c4-864f-419d-a1c0-3e5be1934dc0"
          },
          "id": "b9a833ba-372d-41ef-b8a5-80b182c7cb7a",
          "position": {
            "x": 472,
            "y": 1048
          },
          "type": "jump"
        },
        "bedb8ffd-0ecf-48bb-9ab6-ea1f7aa75961": {
          "data": {
            "isEnd": true,
            "speakerId": "ea5b376a-6183-40a7-8881-86123be65240",
            "text": "Enjoy! See you tomorrow."
          },
          "id": "bedb8ffd-0ecf-48bb-9ab6-ea1f7aa75961",
          "position": {
            "x": 1424,
            "y": 1264
          },
          "type": "dialogue"
        },
        "e0c9c4a9-e659-49b1-9346-1279f085ea5e": {
          "data": {
            "effects": "Player.Coins -= 4\nPlayer.ItemsBought += 1",
            "menuText": "A flat white (4 coins)",
            "note": "Only offered with 4+ coins. Effects spend the coins as the story passes through.",
            "requires": "Player.Coins >= 4",
            "speakerId": "6254c6d9-119b-4d1f-8392-dff6cc609b7d",
            "text": "A flat white, please."
          },
          "id": "e0c9c4a9-e659-49b1-9346-1279f085ea5e",
          "position": {
            "x": 0,
            "y": 424
          },
          "type": "dialogue"
        }
      },
      "order": 0
    }
  },
