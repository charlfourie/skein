      "folderId": null,
      "id": "ced87b88-daaf-445d-b4da-e4db7d994a39",
      "name": "The Order",
      "nodes": {
        "0741fc17-fbf7-4546-9dd8-1806b89c4027": {
          "data": {
            "lineId": "ORDER_0741fc",
            "speakerId": "f3dfa76d-ec5f-4b15-9d59-ef1006a91d63",
            "text": "One flat white, with a fern on top."
          },
          "id": "0741fc17-fbf7-4546-9dd8-1806b89c4027",
          "position": {
            "x": 0,
            "y": 632
          },
          "type": "dialogue"
        },
        "15635f8a-ff9c-4fa4-adc5-1cc0a51e6436": {
          "data": {
            "note": "A jump continues the flow somewhere else: here, back to the menu, so you can keep ordering until the coins run out.",
            "targetId": "4d02fe43-acf4-4a6c-9821-85f2d7c2363b"
          },
          "id": "15635f8a-ff9c-4fa4-adc5-1cc0a51e6436",
          "position": {
            "x": 472,
            "y": 1048
          },
          "type": "jump"
        },
        "1567adc0-af36-4602-8819-8cf8352fafa9": {
          "data": {
            "isEnd": true,
            "lineId": "ORDER_1567ad",
            "speakerId": "f3dfa76d-ec5f-4b15-9d59-ef1006a91d63",
            "text": "Enjoy! See you tomorrow."
          },
          "id": "1567adc0-af36-4602-8819-8cf8352fafa9",
          "position": {
            "x": 1424,
            "y": 1264
          },
          "type": "dialogue"
        },
        "24cb6ec4-a792-48c8-81ec-242f19fc1142": {
          "data": {
            "isStart": true,
            "lineId": "ORDER_24cb6e",
            "note": "Start here. Open Play (the triangle in the toolbar) and watch Coins at the top of the panel.",
            "speakerId": "f3dfa76d-ec5f-4b15-9d59-ef1006a91d63",
            "text": "Morning! What can I get you?"
          },
          "id": "24cb6ec4-a792-48c8-81ec-242f19fc1142",
          "position": {
            "x": 472,
            "y": 0
          },
          "type": "dialogue"
        },
        "2c5fa18f-ae51-40ba-a613-c71cdd3e4354": {
          "data": {
            "lineId": "ORDER_2c5fa1",
            "note": "Braces show a value in the line as it plays: {Player.Coins} becomes the coins you have now. Try it in Play.",
            "speakerId": "f3dfa76d-ec5f-4b15-9d59-ef1006a91d63",
            "text": "Anything else? You’ve got {Player.Coins} left."
          },
          "id": "2c5fa18f-ae51-40ba-a613-c71cdd3e4354",
          "position": {
            "x": 472,
            "y": 840
          },
          "type": "dialogue"
        },
        "3e650e41-25fe-4d23-8e47-869ff26e6d86": {
          "data": {
            "effects": "Player.Coins -= 1\nPlayer.ItemsBought += 1",
            "lineId": "ORDER_3e650e",
            "menuText": "A ginger biscuit (1 coin)",
            "note": "Only offered with 1+ coins. Effects spend the coins as the story passes through.",
            "requires": "Player.Coins >= 1",
            "speakerId": "0a1943b8-de62-44b6-b829-ef96c400b453",
            "text": "And one of those ginger biscuits."
          },
          "id": "3e650e41-25fe-4d23-8e47-869ff26e6d86",
          "position": {
            "x": 632,
            "y": 424
          },
          "type": "dialogue"
        },
        "46c3984d-a437-44b2-becf-1277d4851c32": {
          "data": {
            "lineId": "ORDER_46c398",
            "menuText": "That's everything",
            "speakerId": "0a1943b8-de62-44b6-b829-ef96c400b453",
            "text": "That's everything, thanks."
          },
          "id": "46c3984d-a437-44b2-becf-1277d4851c32",
          "position": {
            "x": 1424,
            "y": 424
          },
          "type": "dialogue"
        },
        "4d02fe43-acf4-4a6c-9821-85f2d7c2363b": {
          "data": {
            "label": "The menu",
            "note": "A hub with several outputs offers a choice. Each priced option has a Requires: when you can't afford it, Play shows it locked with what it needs."
          },
          "id": "4d02fe43-acf4-4a6c-9821-85f2d7c2363b",
          "position": {
            "x": 472,
            "y": 208
          },
          "type": "hub"
        },
        "8ae4d8b2-498c-4e27-ae8b-dc9c1250a20a": {
          "data": {
            "effects": "Player.Coins -= 3\nPlayer.ItemsBought += 1",
            "lineId": "ORDER_8ae4d8",
            "menuText": "Hot chocolate (3 coins)",
            "note": "Only offered with 3+ coins. Effects spend the coins as the story passes through.",
            "requires": "Player.Coins >= 3",
            "speakerId": "0a1943b8-de62-44b6-b829-ef96c400b453",
            "text": "Hot chocolate. Extra marshmallows."
          },
          "id": "8ae4d8b2-498c-4e27-ae8b-dc9c1250a20a",
          "position": {
            "x": 320,
            "y": 424
          },
          "type": "dialogue"
        },
        "916ac652-a47d-41fd-9d07-24379b63b5e7": {
          "data": {
            "lineId": "ORDER_916ac6",
            "speakerId": "f3dfa76d-ec5f-4b15-9d59-ef1006a91d63",
            "text": "On the house!"
          },
          "id": "916ac652-a47d-41fd-9d07-24379b63b5e7",
          "position": {
            "x": 952,
            "y": 632
          },
          "type": "dialogue"
        },
        "9b82776d-8628-4627-b226-48c27269f744": {
          "data": {
            "expression": "Player.Coins >= 1",
            "note": "Conditions branch automatically: green is true, red is false."
          },
          "id": "9b82776d-8628-4627-b226-48c27269f744",
          "position": {
            "x": 1424,
            "y": 632
          },
          "type": "condition"
        },
        "9e67e600-8a8f-40ad-a9fb-3cbf250027cf": {
          "data": {
            "lineId": "ORDER_9e67e6",
            "speakerId": "f3dfa76d-ec5f-4b15-9d59-ef1006a91d63",
            "text": "There's a tip jar by the till, if you like."
          },
          "id": "9e67e600-8a8f-40ad-a9fb-3cbf250027cf",
          "position": {
            "x": 1264,
            "y": 840
          },
          "type": "dialogue"
        },
        "a3e0130b-9c9b-404e-a07f-66eb02ccad37": {
          "data": {
            "effects": "Player.Coins -= 1",
            "lineId": "ORDER_a3e013",
            "menuText": "Drop a coin in the jar (1 coin)",
            "requires": "Player.Coins >= 1",
            "speakerId": "0a1943b8-de62-44b6-b829-ef96c400b453",
            "text": "Here you go."
          },
          "id": "a3e0130b-9c9b-404e-a07f-66eb02ccad37",
          "position": {
            "x": 1104,
            "y": 1048
          },
          "type": "dialogue"
        },
        "a618af6a-5bd7-45ac-9037-ec7684c68a42": {
          "data": {
            "lineId": "ORDER_a618af",
            "menuText": "Just water (free)",
            "note": "Free, so you are never stuck with nothing to pick. Only once: after a glass it leaves the menu, so every path ends (Explore checks this).",
            "once": true,
            "speakerId": "0a1943b8-de62-44b6-b829-ef96c400b453",
            "text": "Just water, thanks."
          },
          "id": "a618af6a-5bd7-45ac-9037-ec7684c68a42",
          "position": {
            "x": 952,
            "y": 424
          },
          "type": "dialogue"
        },
        "a7302af5-cc64-4a50-8f55-05c1e757de17": {
          "data": {
            "isEnd": true,
            "lineId": "ORDER_a7302a",
            "speakerId": "f3dfa76d-ec5f-4b15-9d59-ef1006a91d63",
            "text": "You're a star. Next foam fern is extra leafy."
          },
          "id": "a7302af5-cc64-4a50-8f55-05c1e757de17",
          "position": {
            "x": 1104,
            "y": 1264
          },
          "type": "dialogue"
        },
        "ab47bb16-3c0b-4623-8346-43d31c58ee54": {
          "data": {
            "lineId": "ORDER_ab47bb",
            "speakerId": "f3dfa76d-ec5f-4b15-9d59-ef1006a91d63",
            "text": "Marshmallow tower, coming right up."
          },
          "id": "ab47bb16-3c0b-4623-8346-43d31c58ee54",
          "position": {
            "x": 320,
            "y": 632
          },
          "type": "dialogue"
        },
        "afb64551-5847-43ec-9c32-cb5984340cf2": {
          "data": {
            "lineId": "ORDER_afb645",
            "speakerId": "f3dfa76d-ec5f-4b15-9d59-ef1006a91d63",
            "text": "Last one in the jar. Lucky you."
          },
          "id": "afb64551-5847-43ec-9c32-cb5984340cf2",
          "position": {
            "x": 632,
            "y": 632
          },
          "type": "dialogue"
        },
        "cacd8530-4099-4fdd-9deb-00f2f5862ed7": {
          "data": {
            "effects": "Player.Coins -= 4\nPlayer.ItemsBought += 1",
            "lineId": "ORDER_cacd85",
            "menuText": "A flat white (4 coins)",
            "note": "Only offered with 4+ coins. Effects spend the coins as the story passes through.",
            "requires": "Player.Coins >= 4",
            "speakerId": "0a1943b8-de62-44b6-b829-ef96c400b453",
            "text": "A flat white, please."
          },
          "id": "cacd8530-4099-4fdd-9deb-00f2f5862ed7",
          "position": {
            "x": 0,
            "y": 424
          },
          "type": "dialogue"
        },
        "dc6e8651-7f34-4c45-8662-bc41389d3413": {
          "data": {
            "isEnd": true,
            "lineId": "ORDER_dc6e86",
            "speakerId": "f3dfa76d-ec5f-4b15-9d59-ef1006a91d63",
            "text": "Pockets empty? Come back tomorrow, I'll save you a biscuit."
          },
          "id": "dc6e8651-7f34-4c45-8662-bc41389d3413",
          "position": {
            "x": 1584,
            "y": 840
          },
          "type": "dialogue"
        },
        "eb600423-06c3-4d2d-b908-5ff1e7c41b7a": {
          "data": {
            "lineId": "ORDER_eb6004",
            "menuText": "Not today",
            "speakerId": "0a1943b8-de62-44b6-b829-ef96c400b453",
            "text": "Not today, sorry."
          },
          "id": "eb600423-06c3-4d2d-b908-5ff1e7c41b7a",
          "position": {
            "x": 1424,
            "y": 1048
          },
          "type": "dialogue"
        }
      },
      "order": 0
    }
  },
