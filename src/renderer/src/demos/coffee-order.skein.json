      "name": "The Order",
      "nodes": {
        "0011bf11-5978-4ab3-b908-5d4fb3ea124b": {
          "data": {
            "note": "Instructions change state.",
            "script": "Player.Coins -= 4"
          },
          "id": "0011bf11-5978-4ab3-b908-5d4fb3ea124b",
          "position": {
            "x": 0,
            "y": 840
          },
          "type": "instruction"
        },
        "027f9095-cd4c-4c8c-8ae0-646eea649687": {
          "data": {
            "menuText": "A flat white (4 coins)",
            "speakerId": "7f64b6c3-84e1-4981-b5db-1f40a3bc1232",
            "text": "A flat white, please."
          },
          "id": "027f9095-cd4c-4c8c-8ae0-646eea649687",
          "position": {
            "x": 160,
            "y": 424
          },
          "type": "dialogue"
        },
        "0e251d4e-92ec-4b99-b5ea-22dd1d1ad6f0": {
          "data": {
            "menuText": "Just water",
            "speakerId": "7f64b6c3-84e1-4981-b5db-1f40a3bc1232",
            "text": "Just water, thanks."
          },
          "id": "0e251d4e-92ec-4b99-b5ea-22dd1d1ad6f0",
          "position": {
            "x": 952,
            "y": 840
          },
          "type": "dialogue"
        },
        "4910f236-73b4-44fe-89e9-5b60a7d4a091": {
          "data": {
            "speakerId": "89661055-3329-4643-bc4c-429537950ed7",
            "text": "Ah, you're a little short for that one. Anything else?"
          },
          "id": "4910f236-73b4-44fe-89e9-5b60a7d4a091",
          "position": {
            "x": 320,
            "y": 840
          },
          "type": "dialogue"
        },
        "6010985e-a766-48ea-b776-8dfac6b9b9be": {
          "data": {
            "note": "A jump continues the flow somewhere else: here, back to the menu.",
            "targetId": "64b66e95-eecc-498e-bc7a-6e7425ae19e8"
          },
          "id": "6010985e-a766-48ea-b776-8dfac6b9b9be",
          "position": {
            "x": 320,
            "y": 1048
          },
          "type": "jump"
        },
        "64b66e95-eecc-498e-bc7a-6e7425ae19e8": {
          "data": {
            "label": "The menu",
            "note": "A hub is a meeting point. With several outputs it offers the player a choice. The jump below loops back to it."
          },
          "id": "64b66e95-eecc-498e-bc7a-6e7425ae19e8",
          "position": {
            "x": 632,
            "y": 208
          },
          "type": "hub"
        },
        "68f0e83a-c011-4292-885c-ef9f4cc1f21d": {
          "data": {
            "expression": "Player.Coins >= 4",
            "note": "Conditions branch automatically: green is true, red is false."
          },
          "id": "68f0e83a-c011-4292-885c-ef9f4cc1f21d",
          "position": {
            "x": 160,
            "y": 632
          },
          "type": "condition"
        },
        "88192375-372e-4ce1-938b-0f82e3c91554": {
          "data": {
            "speakerId": "89661055-3329-4643-bc4c-429537950ed7",
            "text": "Marshmallow tower, coming right up."
          },
          "id": "88192375-372e-4ce1-938b-0f82e3c91554",
          "position": {
            "x": 632,
            "y": 1048
          },
          "type": "dialogue"
        },
        "bcf16bee-05d1-4f66-a4e5-96acd34fbca0": {
          "data": {
            "isStart": true,
            "note": "Start here.",
            "speakerId": "89661055-3329-4643-bc4c-429537950ed7",
            "text": "Morning! What can I get you?"
          },
          "id": "bcf16bee-05d1-4f66-a4e5-96acd34fbca0",
          "position": {
            "x": 632,
            "y": 0
          },
          "type": "dialogue"
        },
        "c197c3dd-c4ba-4b18-8b72-29410a5cd349": {
          "data": {
            "speakerId": "89661055-3329-4643-bc4c-429537950ed7",
            "text": "Four coins. One flat white, with a fern on top."
          },
          "id": "c197c3dd-c4ba-4b18-8b72-29410a5cd349",
          "position": {
            "x": 0,
            "y": 1048
          },
          "type": "dialogue"
        },
        "c5f1739f-b5d6-4cde-9e99-26a977c8d2e4": {
          "data": {
            "speakerId": "89661055-3329-4643-bc4c-429537950ed7",
            "text": "On the house!"
          },
          "id": "c5f1739f-b5d6-4cde-9e99-26a977c8d2e4",
          "position": {
            "x": 952,
            "y": 1048
          },
          "type": "dialogue"
        },
        "cbeb1dc6-59ba-44e8-aa07-96838dde4a64": {
          "data": {
            "effects": "Player.Coins -= 3",
            "menuText": "Hot chocolate (3 coins)",
            "note": "Effects change state as the story passes through.",
            "speakerId": "7f64b6c3-84e1-4981-b5db-1f40a3bc1232",
            "text": "Hot chocolate. Extra marshmallows."
          },
          "id": "cbeb1dc6-59ba-44e8-aa07-96838dde4a64",
          "position": {
            "x": 632,
            "y": 840
          },
          "type": "dialogue"
        },
        "d9939ab5-b97d-4d9b-b841-dad5e75363ab": {
          "data": {
            "isEnd": true,
            "speakerId": "89661055-3329-4643-bc4c-429537950ed7",
            "text": "Enjoy! See you tomorrow."
          },
          "id": "d9939ab5-b97d-4d9b-b841-dad5e75363ab",
          "position": {
            "x": 632,
            "y": 1264
          },
          "type": "dialogue"
        }
      },
      "order": 0
    }
