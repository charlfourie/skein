  "flows": {
    "ced87b88-daaf-445d-b4da-e4db7d994a39": {
      "comments": {
        "6b96227d-6c15-4da5-8367-f57cbd17b7c2": {
          "author": "Alex",
          "createdAt": "2026-01-01T00:00:00.000Z",
          "id": "6b96227d-6c15-4da5-8367-f57cbd17b7c2",
