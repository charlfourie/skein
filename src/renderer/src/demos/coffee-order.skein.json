      "folderId": null,
      "id": "175863b3-b4cf-4c8a-ac25-a14cb5245d40",
      "name": "The Order",
      "nodes": {
        "1cbe7e54-0cf8-4b4a-944d-ba7730ee9988": {
          "data": {
            "speakerId": "7e89483f-59aa-4b7a-8930-361b7591d58c",
            "text": "There's a tip jar by the till, if you like."
          },
          "id": "1cbe7e54-0cf8-4b4a-944d-ba7730ee9988",
          "position": {
            "x": 1264,
            "y": 840
          },
          "type": "dialogue"
        },
        "1da5628b-764f-42d7-b9df-98868478b09b": {
          "data": {
            "speakerId": "7e89483f-59aa-4b7a-8930-361b7591d58c",
            "text": "One flat white, with a fern on top."
          },
          "id": "1da5628b-764f-42d7-b9df-98868478b09b",
          "position": {
            "x": 0,
            "y": 632
          },
          "type": "dialogue"
        },
        "224f0443-3e9a-4fac-8c7e-362a76b88724": {
          "data": {
            "menuText": "Just water (free)",
            "note": "Always available, so you are never stuck with nothing to pick.",
            "speakerId": "285ee2d9-384f-45a0-b0ab-519bffa0aa6d",
            "text": "Just water, thanks."
          },
          "id": "224f0443-3e9a-4fac-8c7e-362a76b88724",
          "position": {
            "x": 952,
            "y": 424
          },
          "type": "dialogue"
        },
        "2758a09a-47e9-4f30-a5d8-a515b45cade6": {
          "data": {
            "isStart": true,
            "note": "Start here. Open Play (the triangle in the toolbar) and watch Coins at the top of the panel.",
            "speakerId": "7e89483f-59aa-4b7a-8930-361b7591d58c",
            "text": "Morning! What can I get you?"
          },
          "id": "2758a09a-47e9-4f30-a5d8-a515b45cade6",
          "position": {
            "x": 472,
            "y": 0
          },
          "type": "dialogue"
        },
        "5f95b257-aee3-451b-aa24-a22afda9c40a": {
          "data": {
            "effects": "Player.Coins -= 1\nPlayer.ItemsBought += 1",
            "menuText": "A ginger biscuit (1 coin)",
            "note": "Only offered with 1+ coins. Effects spend the coins as the story passes through.",
            "requires": "Player.Coins >= 1",
            "speakerId": "285ee2d9-384f-45a0-b0ab-519bffa0aa6d",
            "text": "And one of those ginger biscuits."
          },
          "id": "5f95b257-aee3-451b-aa24-a22afda9c40a",
          "position": {
            "x": 632,
            "y": 424
          },
          "type": "dialogue"
        },
        "6d8f77d1-c9d4-47b4-a294-26f85c9134ea": {
          "data": {
            "menuText": "Not today",
            "speakerId": "285ee2d9-384f-45a0-b0ab-519bffa0aa6d",
            "text": "Not today, sorry."
          },
          "id": "6d8f77d1-c9d4-47b4-a294-26f85c9134ea",
          "position": {
            "x": 1424,
            "y": 1048
          },
          "type": "dialogue"
        },
        "7238975f-156f-4488-b053-5304cc3dfe9b": {
          "data": {
            "speakerId": "7e89483f-59aa-4b7a-8930-361b7591d58c",
            "text": "Last one in the jar. Lucky you."
          },
          "id": "7238975f-156f-4488-b053-5304cc3dfe9b",
          "position": {
            "x": 632,
            "y": 632
          },
          "type": "dialogue"
        },
        "8adc9907-1183-472f-bd77-291eb5360eac": {
          "data": {
            "note": "A jump continues the flow somewhere else: here, back to the menu, so you can keep ordering until the coins run out.",
            "targetId": "d0949d67-834e-4750-9b74-c21a19afc149"
          },
          "id": "8adc9907-1183-472f-bd77-291eb5360eac",
          "position": {
            "x": 472,
            "y": 1048
          },
          "type": "jump"
        },
        "93a43509-86d0-454d-8fe7-5845506c523c": {
          "data": {
            "menuText": "That's everything",
            "speakerId": "285ee2d9-384f-45a0-b0ab-519bffa0aa6d",
            "text": "That's everything, thanks."
          },
          "id": "93a43509-86d0-454d-8fe7-5845506c523c",
          "position": {
            "x": 1424,
            "y": 424
          },
          "type": "dialogue"
        },
        "9472caaf-5a74-4872-9d0b-f7555ea82f6b": {
          "data": {
            "effects": "Player.Coins -= 4\nPlayer.ItemsBought += 1",
            "menuText": "A flat white (4 coins)",
            "note": "Only offered with 4+ coins. Effects spend the coins as the story passes through.",
            "requires": "Player.Coins >= 4",
            "speakerId": "285ee2d9-384f-45a0-b0ab-519bffa0aa6d",
            "text": "A flat white, please."
          },
          "id": "9472caaf-5a74-4872-9d0b-f7555ea82f6b",
          "position": {
            "x": 0,
            "y": 424
          },
          "type": "dialogue"
        },
        "9a3ffaa4-c44f-4584-9c48-d4282751d295": {
          "data": {
            "isEnd": true,
            "speakerId": "7e89483f-59aa-4b7a-8930-361b7591d58c",
            "text": "Pockets empty? Come back tomorrow, I'll save you a biscuit."
          },
          "id": "9a3ffaa4-c44f-4584-9c48-d4282751d295",
          "position": {
            "x": 1584,
            "y": 840
          },
          "type": "dialogue"
        },
        "9ee3f5ee-a66b-4107-b77a-d6815e3ca991": {
          "data": {
            "speakerId": "7e89483f-59aa-4b7a-8930-361b7591d58c",
            "text": "Anything else?"
          },
          "id": "9ee3f5ee-a66b-4107-b77a-d6815e3ca991",
          "position": {
            "x": 472,
            "y": 840
          },
          "type": "dialogue"
        },
        "d05f64ed-e584-470e-bbda-fb2875d53ea5": {
          "data": {
            "isEnd": true,
            "speakerId": "7e89483f-59aa-4b7a-8930-361b7591d58c",
            "text": "You're a star. Next foam fern is extra leafy."
          },
          "id": "d05f64ed-e584-470e-bbda-fb2875d53ea5",
          "position": {
            "x": 1104,
            "y": 1264
          },
          "type": "dialogue"
        },
        "d0949d67-834e-4750-9b74-c21a19afc149": {
          "data": {
            "label": "The menu",
            "note": "A hub with several outputs offers a choice. Each priced option has a Requires: when you can't afford it, Play shows it locked with what it needs."
          },
          "id": "d0949d67-834e-4750-9b74-c21a19afc149",
          "position": {
            "x": 472,
            "y": 208
          },
          "type": "hub"
        },
        "d2038b80-fd9e-4078-8557-1d0a94e3b715": {
          "data": {
            "effects": "Player.Coins -= 3\nPlayer.ItemsBought += 1",
            "menuText": "Hot chocolate (3 coins)",
            "note": "Only offered with 3+ coins. Effects spend the coins as the story passes through.",
            "requires": "Player.Coins >= 3",
            "speakerId": "285ee2d9-384f-45a0-b0ab-519bffa0aa6d",
            "text": "Hot chocolate. Extra marshmallows."
          },
          "id": "d2038b80-fd9e-4078-8557-1d0a94e3b715",
          "position": {
            "x": 320,
            "y": 424
          },
          "type": "dialogue"
        },
        "ea8361ee-5194-4662-8b4e-cd26f7ecb7bc": {
          "data": {
            "speakerId": "7e89483f-59aa-4b7a-8930-361b7591d58c",
            "text": "On the house!"
          },
          "id": "ea8361ee-5194-4662-8b4e-cd26f7ecb7bc",
          "position": {
            "x": 952,
            "y": 632
          },
          "type": "dialogue"
        },
        "eacd2e1c-8fa4-4c46-a235-83137cf38ad1": {
          "data": {
            "isEnd": true,
            "speakerId": "7e89483f-59aa-4b7a-8930-361b7591d58c",
            "text": "Enjoy! See you tomorrow."
          },
          "id": "eacd2e1c-8fa4-4c46-a235-83137cf38ad1",
          "position": {
            "x": 1424,
            "y": 1264
          },
          "type": "dialogue"
        },
        "ee828034-0833-4d18-8c81-76f36d4196b5": {
          "data": {
            "expression": "Player.Coins >= 1",
            "note": "Conditions branch automatically: green is true, red is false."
          },
          "id": "ee828034-0833-4d18-8c81-76f36d4196b5",
          "position": {
            "x": 1424,
            "y": 632
          },
          "type": "condition"
        },
        "eef10834-0a5f-4086-8beb-0d1c13fc6b69": {
          "data": {
            "effects": "Player.Coins -= 1",
            "menuText": "Drop a coin in the jar (1 coin)",
            "requires": "Player.Coins >= 1",
            "speakerId": "285ee2d9-384f-45a0-b0ab-519bffa0aa6d",
            "text": "Here you go."
          },
          "id": "eef10834-0a5f-4086-8beb-0d1c13fc6b69",
          "position": {
            "x": 1104,
            "y": 1048
          },
          "type": "dialogue"
        },
        "fe5693c5-6218-4be8-9a82-87eeaed2140a": {
          "data": {
            "speakerId": "7e89483f-59aa-4b7a-8930-361b7591d58c",
            "text": "Marshmallow tower, coming right up."
          },
          "id": "fe5693c5-6218-4be8-9a82-87eeaed2140a",
          "position": {
            "x": 320,
            "y": 632
          },
          "type": "dialogue"
        }
      },
      "order": 0
    }
  },
