{
  "name": "skein",
  "productName": "Skein",
  "version": "0.8.0",
  "description": "Local-first, node-based narrative design editor that runs in your browser. Projects are deterministic JSON files on your disk.",
  "private": true,
  "license": "Apache-2.0",
  "scripts": {
    "dev": "vite --config vite.web.config.ts",
    "build": "vite build --config vite.web.config.ts",
    "preview": "vite preview --config vite.web.config.ts",
    "typecheck:node": "tsc --noEmit -p tsconfig.node.json --composite false",
    "typecheck:web": "tsc --noEmit -p tsconfig.web.json --composite false",
    "typecheck": "npm run typecheck:node && npm run typecheck:web",
    "test": "vitest run",
    "test:watch": "vitest",
    "make:example": "tsx scripts/make-example.ts",
    "make:demos": "tsx scripts/make-demos.ts",
    "export": "tsx scripts/export.ts",
    "test:story": "tsx scripts/test-story.ts",
    "make:schemas": "tsx scripts/make-schemas.ts"
  },
  "dependencies": {
    "@dagrejs/dagre": "^1.1.4",
    "@vercel/analytics": "^2.0.1",
    "@xyflow/react": "^12.3.6",
    "framer-motion": "^11.15.0",
    "immer": "^10.1.1",
    "lucide-react": "^0.468.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-resizable-panels": "^2.1.7",
    "zod": "^3.24.1",
    "zustand": "^5.0.2"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "@types/react": "^18.3.18",
    "@types/react-dom": "^18.3.5",
    "@vitejs/plugin-react": "^4.3.4",
    "ajv": "^8.20.0",
    "autoprefixer": "^10.4.20",
    "postcss": "^8.4.49",
    "tailwindcss": "^3.4.17",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "vite": "^5.4.11",
    "vitest": "^2.1.8",
    "zod-to-json-schema": "^3.25.2"
  }
}
